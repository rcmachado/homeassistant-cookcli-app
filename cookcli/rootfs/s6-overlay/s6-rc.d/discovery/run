#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community App: CookCLI
# Sends discovery information to Home Assistant.
# ==============================================================================
declare config

# Wait for CookCLI server to become available
bashio::net.wait_for 8099 127.0.0.1 300

config=$(\
    bashio::var.json \
        hostname "http://$(bashio::app.hostname):8099" \
)

if bashio::discovery "cookcli" "${config}" > /dev/null; then
    bashio::log.info "Successfully send discovery information to Home Assistant."
else
    bashio::log.error "Discovery message to Home Assistant failed!"
fi